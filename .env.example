# Скопируй этот файл в .env и вставь свои ключи.
# .env игнорируется git — в репозиторий он не попадёт.

# Обязателен. Распознавание речи. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Необязателен. Вычитка транскрипта (пунктуация, слова-паразиты).
# Оставь пустым или удали строку — шаг вычитки просто не включится,
# приложение продолжит работать на одном OpenAI.
DEEPSEEK_API_KEY=
