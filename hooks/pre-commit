#!/usr/bin/env bash
# voicetype: не даём закоммитить секреты.
set -u

fail() { echo "pre-commit: $*" >&2; exit 1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
    case "$f" in
        .env|.env.local|*.key|*.pem)
            fail "в коммит попал файл с секретами: $f
  убери его:  git restore --staged $f" ;;
    esac
done <<< "$staged"

# Ключ вида sk-... в добавленных строках.
if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'sk-[A-Za-z0-9_-]{20,}'; then
    fail "в добавленных строках найден ключ вида sk-...
  проверь:  git diff --cached | grep sk-"
fi

exit 0
